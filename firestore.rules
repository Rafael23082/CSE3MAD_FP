rules_version = '2';

// STEMM Lab - Firestore Security Rules
// Students can only access their own data

// Helper: check if user is authenticated
function isAuth() {
  return request.auth != null;
}

// Helper: get the requesting user's UID
function uid() {
  return request.auth.uid;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Users collection
    // ==========================================
    match /users/{userId} {
      // Anyone authenticated can read their own profile
      allow read: if isAuth() && request.auth.uid == userId;

      // Allow create during signup
      allow create: if isAuth() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.createdAt is timestamp;

      // Users can update their own profile (not email, not uid)
      allow update: if isAuth() && request.auth.uid == userId;

      // No one can delete user documents
      allow delete: if false;
    }

    // ==========================================
    // Submissions collection
    // ==========================================
    match /submissions/{submissionId} {
      // Users can read their own submissions
      allow read: if isAuth() && resource.data.userId == uid();

      // Authenticated users can create submissions for themselves
      allow create: if isAuth()
        && request.resource.data.keys().hasAll(['userId', 'activityKey', 'submittedAt'])
        && request.resource.data.userId == uid()
        && request.resource.data.activityKey is string
        && request.resource.data.activityKey.size() >= 1
        && request.resource.data.reflection is string
        && request.resource.data.reflection.size() <= 2000
        && request.resource.data.submittedAt is timestamp;

      // Only the submitter can update their own submission
      allow update: if isAuth() && resource.data.userId == uid();

      // No one can delete submissions
      allow delete: if false;
    }

    // ==========================================
    // Default: deny everything else
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
