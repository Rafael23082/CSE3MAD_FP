rules_version = '2';

// STEMM Lab - Firebase Storage Security Rules
// Students can only access their own uploads

service firebase.storage {
  match /b/{bucket}/o {
    // User uploads: only the authenticated user can manage their own files
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024; // 50MB max per file
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Activity submissions: team members can access
    match /submissions/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }

    // Public assets: anyone can read
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
